<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#0b6b72">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<title>Registro de Soportes</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap">
<style>
html{color-scheme:light}body{margin:0}img{max-width:100%}[hidden]{display:none!important}
/* Hoja de registro: encabezado fijo con resumen, lista de soportes con hora y duración, panel lateral para registrar */
:root {
  --bg: #f1f5f5; --surface: #ffffff; --surface-2: #e7eeef; --line: #d2dcde;
  --fg: #12272b; --muted: #556b70; --accent: #0b6b72; --accent-ink: #ffffff; --accent-soft: #d6ecec;
  --abierto: #9a5b00; --abierto-soft: #fbf0cf; --ok: #1d7444; --ok-soft: #d8efe1; --danger: #b42318;
  --scrim: rgba(8,22,25,.45);
  --font-ui: "IBM Plex Sans", "Segoe UI", system-ui, sans-serif;
  --font-mono: "IBM Plex Mono", ui-monospace, Consolas, monospace;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #0d1618; --surface: #142124; --surface-2: #1b2b2f; --line: #2a3d41;
    --fg: #e2edee; --muted: #93a7ab; --accent: #3db3ba; --accent-ink: #052022; --accent-soft: #13383b;
    --abierto: #e6c158; --abierto-soft: #352c13; --ok: #6ccf97; --ok-soft: #142e1e; --danger: #f28a80;
    --scrim: rgba(0,0,0,.6); color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --bg: #0d1618; --surface: #142124; --surface-2: #1b2b2f; --line: #2a3d41;
  --fg: #e2edee; --muted: #93a7ab; --accent: #3db3ba; --accent-ink: #052022; --accent-soft: #13383b;
  --abierto: #e6c158; --abierto-soft: #352c13; --ok: #6ccf97; --ok-soft: #142e1e; --danger: #f28a80;
  --scrim: rgba(0,0,0,.6); color-scheme: dark;
}
* { box-sizing: border-box; }
[hidden] { display: none !important; }
body { background: var(--bg); color: var(--fg); font: 14px/1.45 var(--font-ui); }
body::before { content: ""; position: fixed; inset: 0 0 auto; height: env(safe-area-inset-top, 0px); z-index: 30; background: var(--surface); }
h1, h2, h3 { text-wrap: balance; margin: 0; }
.wrap { max-width: 1060px; margin: 0 auto; padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); }
.mono { font-family: var(--font-mono); font-variant-numeric: tabular-nums; }

.top { position: sticky; top: env(safe-area-inset-top, 0px); z-index: 20; background: var(--surface); border-bottom: 1px solid var(--line); }
.top-row { display: flex; align-items: center; gap: 12px; padding-block: 12px; flex-wrap: wrap; }
.brand { display: flex; align-items: center; gap: 10px; flex: 1; min-width: 0; }
.mark { flex: none; width: 36px; height: 36px; border-radius: 9px; background: var(--accent); color: var(--accent-ink); display: grid; place-items: center; font: 600 14px var(--font-mono); }
.brand h1 { font-size: 18px; font-weight: 700; letter-spacing: -.01em; }
.brand p { margin: 0; color: var(--muted); font-size: 12px; }

.btn { font: inherit; font-weight: 600; border-radius: 9px; padding: 9px 15px; border: 1px solid var(--line); background: var(--surface); color: var(--fg); cursor: pointer; display: inline-flex; align-items: center; justify-content: center; gap: 6px; min-height: 40px; white-space: nowrap; }
.btn:hover { background: var(--surface-2); }
.btn:disabled { opacity: .55; cursor: not-allowed; }
.btn.primary { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); }
.btn.primary:hover { filter: brightness(1.07); }
.btn.danger { color: var(--danger); border-color: var(--danger); background: transparent; }
.btn.danger.solid { background: var(--danger); color: #fff; }
.btn.small { padding: 5px 11px; min-height: 32px; font-size: 13px; }
.btn.link { border: 0; background: none; padding: 0; min-height: 0; color: var(--fg); text-align: left; white-space: normal; font-weight: 600; }
.btn.link:hover { color: var(--accent); background: none; }
:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

main.wrap { padding-block: 16px 60px; display: grid; gap: 14px; }
.banner { padding: 10px 12px; border-radius: 8px; background: var(--surface-2); font-size: 13px; }
.banner[data-tone="warn"] { background: var(--abierto-soft); }
.banner[data-tone="error"] { background: #fde2df; color: #7a1a12; }
:root[data-theme="dark"] .banner[data-tone="error"], @media (prefers-color-scheme: dark) { }

.kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 8px; }
.kpi { background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 10px 12px; display: flex; flex-direction: column; gap: 2px; }
.k-label { font-size: 11px; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); font-weight: 600; }
.k-val { font: 600 23px/1.15 var(--font-mono); }

.sec-head { display: flex; justify-content: space-between; align-items: center; gap: 8px; flex-wrap: wrap; }
.sec-head h2 { font-size: 16px; }
.count { color: var(--muted); font-size: 13px; }
.acts { display: flex; gap: 8px; flex-wrap: wrap; }

.filters { display: flex; flex-wrap: wrap; gap: 8px; align-items: end; }
.filters .field { flex: 1 1 150px; }
.filters .field.grow { flex: 3 1 220px; }
.field { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
.field > span { font-size: 12px; font-weight: 600; color: var(--muted); }
input, select, textarea { font: inherit; color: var(--fg); background: var(--surface); border: 1px solid var(--line); border-radius: 8px; padding: 8px 10px; min-height: 40px; width: 100%; }
textarea { min-height: 80px; resize: vertical; line-height: 1.45; }

.list { display: flex; flex-direction: column; gap: 8px; }
.row { display: grid; grid-template-columns: 60px minmax(0,1fr) 150px 150px; grid-template-areas: "n m h a"; gap: 4px 10px; background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 11px 13px; cursor: pointer; align-items: center; }
.row:hover { border-color: var(--accent); }
.r-n { grid-area: n; font: 600 14px var(--font-mono); color: var(--muted); }
.r-main { grid-area: m; display: flex; flex-direction: column; gap: 3px; min-width: 0; }
.r-sol { overflow-wrap: anywhere; }
.r-sol .btn.link { font-weight: 600; }
.r-meta { font-size: 12px; color: var(--muted); overflow-wrap: anywhere; }
.r-h { grid-area: h; display: flex; flex-direction: column; gap: 2px; font: 500 12px var(--font-mono); color: var(--muted); }
.r-h b { color: var(--fg); font-size: 13px; }
.r-a { grid-area: a; display: flex; align-items: center; justify-content: flex-end; }
.pill { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 600; padding: 4px 10px; border-radius: 999px; background: var(--accent-soft); color: var(--accent); white-space: nowrap; }
.dur { display: inline-block; font: 500 12px var(--font-mono); padding: 2px 7px; border-radius: 5px; background: var(--surface-2); color: var(--muted); }
.dur[data-abierto="1"] { background: var(--abierto-soft); color: var(--abierto); }

.empty { padding: 28px 16px; text-align: center; color: var(--muted); background: var(--surface); border: 1px dashed var(--line); border-radius: 10px; }
.empty b { display: block; color: var(--fg); margin-bottom: 4px; }

.scrim { position: fixed; inset: 0; background: var(--scrim); z-index: 40; }
.drawer { position: fixed; top: 0; right: 0; bottom: 0; width: min(500px, 100%); background: var(--surface); z-index: 41; display: flex; flex-direction: column; border-left: 1px solid var(--line); box-shadow: -14px 0 36px rgba(0,0,0,.2); padding-top: env(safe-area-inset-top, 0px); padding-bottom: env(safe-area-inset-bottom, 0px); padding-right: env(safe-area-inset-right, 0px); }
.d-head { display: flex; justify-content: space-between; align-items: center; gap: 8px; padding: 14px 16px; border-bottom: 1px solid var(--line); }
.d-head h2 { font-size: 16px; }
.d-head p { margin: 2px 0 0; font-size: 12px; color: var(--muted); }
.d-body { overflow-y: auto; padding: 16px; flex: 1; }
.d-foot { padding: 12px 16px; border-top: 1px solid var(--line); display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
.d-foot .sp { flex: 1; }
.form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.form-grid .full { grid-column: 1 / -1; }
.hint { font-size: 12px; color: var(--muted); margin: 0; }
.warn-txt { color: var(--danger); font-weight: 600; }
.confirm { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; font-size: 13px; font-weight: 600; color: var(--danger); }

.toast { position: fixed; left: 50%; transform: translateX(-50%); bottom: calc(18px + env(safe-area-inset-bottom, 0px)); background: var(--fg); color: var(--bg); padding: 10px 16px; border-radius: 8px; z-index: 60; font-weight: 500; max-width: calc(100% - 32px); box-shadow: 0 6px 20px rgba(0,0,0,.25); }
.toast[data-tone="error"] { background: var(--danger); color: #fff; }

@media (max-width: 720px) {
  .row { grid-template-columns: 44px minmax(0,1fr); grid-template-areas: "n m" "n h" "n a"; }
  .r-h { flex-direction: row; gap: 10px; align-items: baseline; }
  .r-a { justify-content: flex-start; }
}
@media (max-width: 480px) { .form-grid { grid-template-columns: 1fr; } }
@media (prefers-reduced-motion: no-preference) { .row, .btn, .kpi { transition: border-color .15s, background-color .15s; } }
</style>

</head>
<body>
<header class="top">
  <div class="wrap top-row">
    <div class="brand">
      <div class="mark" aria-hidden="true">TIC</div>
      <div>
        <h1>Registro de Soportes</h1>
        <p>Área de Sistemas · <span id="hoy-txt" class="mono"></span></p>
      </div>
    </div>
    <button class="btn primary" id="btn-nuevo" type="button">+ Nuevo soporte</button>
  </div>
</header>

<main class="wrap">
  <div id="banner" class="banner" hidden></div>
  <section class="kpis" id="kpis" aria-label="Resumen"></section>

  <div class="sec-head">
    <h2>Soportes <span class="count" id="count"></span></h2>
    <div class="acts"><button class="btn small" type="button" id="btn-import">Importar</button><button class="btn small" type="button" id="btn-backup">Respaldo</button><button class="btn small primary" type="button" id="btn-export">Exportar a Excel</button><input type="file" id="file-import" accept=".json" hidden></div>
  </div>
  <div class="filters">
    <label class="field grow"><span>Buscar</span><input id="f-q" type="search" placeholder="Usuario o solicitud…"></label>
    <label class="field"><span>Atendido por</span><select id="f-por"></select></label>
    <label class="field"><span>Período</span>
      <select id="f-per"><option value="">Todos</option><option value="hoy">Hoy</option><option value="semana">Esta semana</option></select>
    </label>
  </div>
  <div class="list" id="lista"></div>
</main>

<div class="scrim" id="scrim" hidden></div>
<aside class="drawer" id="drawer" hidden aria-modal="true" role="dialog" aria-labelledby="d-title">
  <div class="d-head">
    <div><h2 id="d-title">Nuevo soporte</h2><p id="d-sub"></p></div>
    <button class="btn small" type="button" data-cerrar>Cerrar</button>
  </div>
  <form id="form" class="d-body" novalidate>
    <div class="form-grid">
      <label class="field"><span>Fecha *</span><input type="date" id="c-fecha" required></label>
      <label class="field"><span>Atendido por</span><input id="c-por" list="dl-por" autocomplete="off" placeholder="Quién atendió"></label>
      <label class="field full"><span>Usuario *</span><input id="c-usuario" required placeholder="Nombre del usuario o área"></label>
      <label class="field full"><span>Solicitud *</span><textarea id="c-sol" required placeholder="Qué pidió o qué falla reportó"></textarea></label>
      <label class="field"><span>Hora inicio</span><input type="time" id="c-ini"></label>
      <label class="field"><span>Hora fin</span><input type="time" id="c-fin"></label>
      <p class="hint full" id="c-dur"></p>
      <p class="hint full" id="c-err" role="alert"></p>
    </div>
  </form>
  <div class="d-foot">
    <div id="d-borrar"></div><span class="sp"></span>
    <button class="btn" type="button" data-cerrar>Cancelar</button>
    <button class="btn primary" type="button" id="btn-guardar">Guardar</button>
  </div>
</aside>

<datalist id="dl-por"></datalist>
<div class="toast" id="toast" role="status" hidden></div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script>
(() => {
  const POR_BASE = ["Elian Cantillo", "Jefe de Sistemas"];
  const KEY = "registro_soportes_v1";
  const $ = (s, r = document) => r.querySelector(s);
  const esc = (s) => String(s ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
  const iso = (d) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
  const hoy = () => iso(new Date());
  const fmt = (s) => { if (!s) return ""; const [y, m, d] = s.split("-"); return `${d}/${m}/${y}`; };
  const corto = (s) => { const [, m, d] = s.split("-"); return `${d}/${m}`; };
  const inicioSemana = () => { const d = new Date(); d.setDate(d.getDate() - ((d.getDay() + 6) % 7)); return iso(d); };
  const min = (t) => { if (!/^\d{1,2}:\d{2}/.test(t || "")) return null; const [h, m] = t.split(":").map(Number); return h * 60 + m; };
  const durMin = (c) => { const a = min(c.horaInicio), b = min(c.horaFin); if (a == null || b == null) return null; return b >= a ? b - a : b + 1440 - a; };
  const durTxt = (n) => n == null ? "" : `${Math.floor(n / 60)}h ${String(n % 60).padStart(2, "0")}m`;
  const opts = (arr, sel, vacio) => (vacio !== undefined ? `<option value="">${esc(vacio)}</option>` : "") + arr.map((v) => `<option${v === sel ? " selected" : ""}>${esc(v)}</option>`).join("");
  const uid = () => Date.now().toString(36) + Math.random().toString(36).slice(2, 7);

  const S = { rows: [], edit: null, borrando: false, f: { q: "", por: "", per: "" } };

  function load() { try { const raw = localStorage.getItem(KEY); S.rows = raw ? JSON.parse(raw) : []; } catch (e) { S.rows = []; } }
  function save() { try { localStorage.setItem(KEY, JSON.stringify(S.rows)); } catch (e) { toast("No se pudo guardar en este navegador.", "error"); } }

  const nums = () => { const m = new Map(); [...S.rows].sort((a, b) => (a.creado || "").localeCompare(b.creado || "")).forEach((r, i) => m.set(r.id, i + 1)); return m; };
  const nombresPor = () => [...new Set([...POR_BASE, ...S.rows.map((r) => r.atendidoPor).filter(Boolean)])];

  let toastT;
  function toast(msg, tone) { const t = $("#toast"); t.textContent = msg; t.dataset.tone = tone || ""; t.hidden = false; clearTimeout(toastT); toastT = setTimeout(() => (t.hidden = true), 3200); }

  function renderBanner() {
    const b = $("#banner");
    b.dataset.tone = ""; b.hidden = false;
    b.innerHTML = 'Los datos se guardan en este navegador. Usa <b>Respaldo</b> para descargar una copia y <b>Importar</b> para traerla en otro equipo o navegador.';
  }
  function renderKPIs() {
    const h = hoy(), sem = inicioSemana();
    const delDia = S.rows.filter((r) => r.fecha === h);
    const minHoy = delDia.reduce((a, r) => a + (durMin(r) || 0), 0);
    const items = [["Soportes hoy", delDia.length], ["Esta semana", S.rows.filter((r) => r.fecha >= sem && r.fecha <= h).length], ["Total", S.rows.length], ["Tiempo hoy", durTxt(minHoy) || "0h 00m"]];
    $("#kpis").innerHTML = items.map(([l, v]) => `<div class="kpi"><span class="k-label">${esc(l)}</span><span class="k-val">${esc(v)}</span></div>`).join("");
  }
  function filtrar() {
    const f = S.f, q = f.q.trim().toLowerCase(), h = hoy(), sem = inicioSemana();
    return S.rows.filter((r) => {
      if (f.por && r.atendidoPor !== f.por) return false;
      if (f.per === "hoy" && r.fecha !== h) return false;
      if (f.per === "semana" && !(r.fecha >= sem && r.fecha <= h)) return false;
      if (q && !`${r.usuario} ${r.solicitud} ${r.atendidoPor}`.toLowerCase().includes(q)) return false;
      return true;
    }).sort((a, b) => (b.fecha || "").localeCompare(a.fecha || "") || (b.horaInicio || "").localeCompare(a.horaInicio || "") || (b.creado || "").localeCompare(a.creado || ""));
  }
  function fila(r, n) {
    const d = durMin(r), abierto = r.horaInicio && !r.horaFin;
    const horas = r.horaInicio || r.horaFin ? `${esc(r.horaInicio || "—")} a ${esc(r.horaFin || "—")}` : "Sin hora";
    return `<article class="row" data-id="${esc(r.id)}">
      <span class="r-n">N° ${n}</span>
      <div class="r-main"><div class="r-sol"><button class="btn link" type="button" data-abrir="${esc(r.id)}">${esc(r.solicitud || "(sin descripción)")}</button></div>
        <div class="r-meta">${esc(r.usuario || "")}${r.fecha ? " · " + corto(r.fecha) : ""}</div></div>
      <div class="r-h"><b>${horas}</b>${d != null ? `<span class="dur">${durTxt(d)}</span>` : abierto ? `<span class="dur" data-abierto="1">En curso</span>` : ""}</div>
      <div class="r-a">${r.atendidoPor ? `<span class="pill">${esc(r.atendidoPor)}</span>` : ""}</div>
    </article>`;
  }
  function renderLista() {
    const rows = filtrar(), N = nums();
    $("#count").textContent = `${rows.length} de ${S.rows.length}`;
    const box = $("#lista");
    if (!S.rows.length) { box.innerHTML = `<div class="empty"><b>Aún no hay soportes registrados.</b>Usa “+ Nuevo soporte” cada vez que atiendas a un usuario.</div>`; return; }
    if (!rows.length) { box.innerHTML = `<div class="empty"><b>Ningún registro coincide.</b>Cambia los filtros o borra la búsqueda.</div>`; return; }
    box.innerHTML = rows.map((r) => fila(r, N.get(r.id))).join("");
  }
  function renderFiltros() { $("#f-por").innerHTML = opts(nombresPor(), S.f.por, "Todos"); $("#dl-por").innerHTML = nombresPor().map((v) => `<option value="${esc(v)}">`).join(""); }
  function render() { $("#hoy-txt").textContent = fmt(hoy()); renderBanner(); renderKPIs(); renderFiltros(); renderLista(); }

  let ultimoFoco = null;
  function abrir(reg) {
    S.edit = reg ? reg.id : null; S.borrando = false; ultimoFoco = document.activeElement;
    const d = reg || {};
    $("#d-title").textContent = reg ? "Editar soporte" : "Nuevo soporte";
    $("#d-sub").textContent = reg ? `N° ${nums().get(reg.id)}` : "Registra la atención a un usuario";
    $("#c-fecha").value = d.fecha || hoy(); $("#c-por").value = d.atendidoPor || "";
    $("#c-usuario").value = d.usuario || ""; $("#c-sol").value = d.solicitud || "";
    $("#c-ini").value = d.horaInicio || ""; $("#c-fin").value = d.horaFin || "";
    $("#c-err").textContent = ""; actualizarDur(); renderBorrar();
    $("#scrim").hidden = false; $("#drawer").hidden = false;
    setTimeout(() => $(reg ? "#c-sol" : "#c-usuario").focus(), 30);
  }
  function cerrar() { $("#scrim").hidden = true; $("#drawer").hidden = true; S.edit = null; if (ultimoFoco && document.contains(ultimoFoco)) ultimoFoco.focus(); }
  function actualizarDur() { const n = durMin({ horaInicio: $("#c-ini").value, horaFin: $("#c-fin").value }); $("#c-dur").innerHTML = n != null ? `Duración: <b>${durTxt(n)}</b>` : ""; }
  function renderBorrar() {
    const box = $("#d-borrar");
    if (!S.edit) { box.innerHTML = ""; return; }
    box.innerHTML = S.borrando
      ? `<div class="confirm">¿Eliminar este registro? <button class="btn small danger solid" type="button" id="btn-borrar-si">Sí</button><button class="btn small" type="button" id="btn-borrar-no">No</button></div>`
      : `<button class="btn small danger" type="button" id="btn-borrar">Eliminar</button>`;
  }
  function guardar() {
    const ahora = new Date().toISOString();
    const datos = { fecha: $("#c-fecha").value, atendidoPor: $("#c-por").value.trim(), usuario: $("#c-usuario").value.trim(),
      solicitud: $("#c-sol").value.trim(), horaInicio: $("#c-ini").value, horaFin: $("#c-fin").value, actualizado: ahora };
    const faltan = [!datos.fecha && "la fecha", !datos.usuario && "el usuario", !datos.solicitud && "la solicitud"].filter(Boolean);
    if (faltan.length) { $("#c-err").innerHTML = `<span class="warn-txt">Falta ${faltan.join(", ")}.</span>`; return; }
    if (S.edit) { const r = S.rows.find((x) => x.id === S.edit); Object.assign(r, datos); }
    else S.rows.push({ id: uid(), creado: ahora, ...datos });
    save(); toast(S.edit ? "Soporte actualizado" : "Soporte registrado"); cerrar(); render();
  }
  function borrar() { S.rows = S.rows.filter((x) => x.id !== S.edit); save(); toast("Registro eliminado"); cerrar(); render(); }

  function descargar(filename, data, mime) {
    const blob = new Blob([data], { type: mime });
    const url = URL.createObjectURL(blob), a = document.createElement("a");
    a.href = url; a.download = filename; document.body.appendChild(a); a.click();
    setTimeout(() => { URL.revokeObjectURL(url); a.remove(); }, 1500);
  }
  function exportar() {
    const N = nums();
    const filas = [...S.rows].sort((a, b) => N.get(a.id) - N.get(b.id)).map((r) => ({
      "N°": N.get(r.id), "Fecha": fmt(r.fecha), "Usuario": r.usuario || "", "Solicitud": r.solicitud || "",
      "Hora inicio": r.horaInicio || "", "Hora fin": r.horaFin || "", "Duración": durTxt(durMin(r)), "Atendido por": r.atendidoPor || "",
    }));
    if (!filas.length) { toast("No hay datos para exportar."); return; }
    if (window.XLSX) {
      const X = window.XLSX, ws = X.utils.json_to_sheet(filas), wb = X.utils.book_new();
      ws["!cols"] = Object.keys(filas[0]).map((k) => ({ wch: k === "Solicitud" ? 50 : Math.max(10, k.length + 3) }));
      X.utils.book_append_sheet(wb, ws, "Soportes");
      const out = X.write(wb, { bookType: "xlsx", type: "array" });
      descargar(`registro_soportes_${hoy()}.xlsx`, out, "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
    } else {
      const cols = Object.keys(filas[0]), q = (v) => `"${String(v).replace(/"/g, '""')}"`;
      descargar(`registro_soportes_${hoy()}.csv`, "﻿" + [cols.map(q).join(";"), ...filas.map((f) => cols.map((c) => q(f[c])).join(";"))].join("\r\n"), "text/csv;charset=utf-8");
    }
    toast("Archivo descargado");
  }
  function respaldo() {
    if (!S.rows.length) { toast("No hay datos para respaldar."); return; }
    descargar(`respaldo_soportes_${hoy()}.json`, JSON.stringify(S.rows, null, 2), "application/json");
    toast("Respaldo descargado");
  }
  async function importar(file) {
    if (!file) return;
    try {
      const data = JSON.parse(await file.text());
      if (!Array.isArray(data)) throw new Error("fmt");
      const map = new Map(S.rows.map((r) => [r.id, r]));
      let n = 0;
      data.forEach((r) => { if (r && typeof r === "object") { const id = r.id || uid(); map.set(id, { ...r, id }); n++; } });
      S.rows = [...map.values()]; save(); render();
      toast(`Importados ${n} registros.`);
    } catch (e) { toast("El archivo no es un respaldo válido (.json).", "error"); }
    finally { $("#file-import").value = ""; }
  }

  document.addEventListener("click", (ev) => {
    const t = ev.target.closest("button, .row");
    if (!t) return;
    if (t.matches("[data-cerrar]")) return cerrar();
    if (t.matches("[data-abrir]")) { const r = S.rows.find((x) => x.id === t.dataset.abrir); if (r) abrir(r); return; }
    if (t.matches(".row")) { const r = S.rows.find((x) => x.id === t.dataset.id); if (r) abrir(r); return; }
    if (t.id === "btn-nuevo") return abrir(null);
    if (t.id === "btn-guardar") return guardar();
    if (t.id === "btn-export") return exportar();
    if (t.id === "btn-backup") return respaldo();
    if (t.id === "btn-import") { $("#file-import").click(); return; }
    if (t.id === "btn-borrar") { S.borrando = true; renderBorrar(); $("#btn-borrar-si").focus(); return; }
    if (t.id === "btn-borrar-no") { S.borrando = false; renderBorrar(); return; }
    if (t.id === "btn-borrar-si") return borrar();
  });
  $("#scrim").addEventListener("click", cerrar);
  document.addEventListener("keydown", (e) => { if (e.key === "Escape" && !$("#drawer").hidden) cerrar(); });
  $("#form").addEventListener("submit", (e) => { e.preventDefault(); guardar(); });
  $("#c-ini").addEventListener("input", actualizarDur);
  $("#c-fin").addEventListener("input", actualizarDur);
  $("#file-import").addEventListener("change", (e) => importar(e.target.files && e.target.files[0]));
  let qT;
  $("#f-q").addEventListener("input", (e) => { clearTimeout(qT); qT = setTimeout(() => { S.f.q = e.target.value; renderLista(); }, 150); });
  $("#f-por").addEventListener("change", (e) => { S.f.por = e.target.value; renderLista(); });
  $("#f-per").addEventListener("change", (e) => { S.f.per = e.target.value; renderLista(); });

  load(); render();
})();
</script>
</body>
</html>
